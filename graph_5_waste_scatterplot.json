          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": "Kerbside waste diverted from landfill",
            "labelExpr": "datum.value + '%'",
            "tickCount": 6
          }
        },
        "x2": {
          "field": "annotation_x"
        },
        "y2": {
          "field": "annotation_y"
        }
      },
      "transform": [
        {
          "filter": "datum.council === 'Alpine Shire'"
        },
        {
          "calculate": "120",
          "as": "annotation_x"
        },
        {
          "calculate": "82",
          "as": "annotation_y"
        }
      ]
    },
    {
      "mark": {
        "type": "point",
        "shape": "triangle-up",
        "filled": true,
        "color": "#526b82",
        "size": 90,
        "strokeWidth": 0,
        "aria": false,
        "xOffset": {
          "expr": "-sin(datum.annotation_arrow_angle * PI / 180) * 9"
        },
        "yOffset": {
          "expr": "cos(datum.annotation_arrow_angle * PI / 180) * 9"
        }
      },
      "encoding": {
        "x": {
          "field": "garbage_collection_cost",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              500
            ]
          },
          "axis": {
            "title": "Garbage collection cost (AUD per bin)",
            "format": "$,.0f",
            "tickCount": 6
          }
        },
        "y": {
          "field": "landfill_diversion_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": "Kerbside waste diverted from landfill",
            "labelExpr": "datum.value + '%'",
            "tickCount": 6
          }
        },
        "angle": {
          "field": "annotation_arrow_angle",
          "type": "quantitative",
          "scale": null
        },
        "tooltip": null
      },
      "transform": [
        {
          "filter": "datum.council === 'Alpine Shire'"
        },
        {
          "calculate": "120",
          "as": "annotation_x"
        },
        {
          "calculate": "82",
          "as": "annotation_y"
        },
        {
          "calculate": "atan2((datum.garbage_collection_cost-datum.annotation_x) * 1.64, (datum.landfill_diversion_pct-datum.annotation_y) * 4.2) * 180 / PI",
          "as": "annotation_arrow_angle"
        }
      ],
      "name": "annotation_arrow_5_root_6"
    },
