              100
            ]
          },
          "axis": {
            "title": "Kerbside waste diverted from landfill",
            "labelExpr": "datum.value + '%'",
            "tickCount": 6
          }
        }
      },
      "mark": {
        "type": "point",
        "filled": true,
        "size": 145,
        "color": "#08519c",
        "stroke": "white",
        "strokeWidth": 2
      }
    },
    {
      "transform": [
        {
          "filter": "datum.council === 'Melbourne City'"
        },
        {
          "calculate": "460",
          "as": "annotation_x"
        },
        {
          "calculate": "21",
          "as": "annotation_y"
        }
      ],
      "encoding": {
        "x": {
          "field": "annotation_x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              500
            ]
          },
          "axis": {
            "title": "Garbage collection cost (AUD per bin)",
            "format": "$,.0f",
            "tickCount": 6
          }
        },
        "y": {
          "field": "annotation_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": "Kerbside waste diverted from landfill",
            "labelExpr": "datum.value + '%'",
            "tickCount": 6
          }
        },
        "text": {
          "value": "Melbourne: $476/bin; 28.5% diverted"
        }
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -7,
        "dy": 0,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#08519c"
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#526b82",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "garbage_collection_cost",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              500
            ]
          },
          "axis": {
            "title": "Garbage collection cost (AUD per bin)",
            "format": "$,.0f",
            "tickCount": 6
          }
