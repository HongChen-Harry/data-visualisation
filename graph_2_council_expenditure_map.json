                    "parse": {
                      "lga_code": "string"
                    }
                  }
                },
                "key": "lga_code",
                "fields": [
                  "council"
                ]
              }
            }
          ],
          "encoding": {
            "opacity": {
              "condition": [
                {
                  "test": "datum.council === selectedMapCouncil",
                  "value": 1
