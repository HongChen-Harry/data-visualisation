              "filter": "datum.longitude >= 144.88 && datum.longitude <= 145.08 && datum.latitude >= -37.9 && datum.latitude <= -37.74"
            },
            {
              "filter": "facilityRegion === 'All regions' || datum.region === facilityRegion"
            }
          ],
          "mark": {
            "type": "circle",
            "size": 7,
            "color": "#245f8c",
            "opacity": 0.48,
            "aria": false,
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "name",
                "title": "Facility"
              },
              {
                "field": "region",
                "title": "Council / LGA"
              },
              {
                "field": "town",
                "title": "Town"
              },
              {
                "field": "address",
                "title": "Address"
              },
              {
                "field": "accessible",
                "title": "Accessible toilet listed"
              }
            ]
          }
        },
        {
          "name": "council_label_1_halo",
          "data": {
            "url": "data/maps/graph_10_central_council_labels.csv"
          },
          "transform": [
            {
              "calculate": "split(replace(datum.LGA_NAME25, ' (Vic.)', ''), ' ')",
              "as": "label_lines"
            }
          ],
          "mark": {
            "type": "text",
            "font": "Arial",
            "fontWeight": "bold",
            "fontSize": 9,
            "lineHeight": 10,
            "color": "#29475a",
            "stroke": "white",
            "strokeWidth": 2,
            "strokeOpacity": 0.9,
            "align": {
              "expr": "indexof(['Manningham', 'Monash'], datum.LGA_NAME25) >= 0 ? 'right' : indexof(['Maribyrnong', 'Hobsons Bay'], datum.LGA_NAME25) >= 0 ? 'left' : 'center'"
            },
            "baseline": "middle",
            "tooltip": false,
            "clip": true,
            "strokeJoin": "round"
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "label_lines"
            },
            "opacity": {
              "condition": {
                "test": "facilityRegion === 'All regions' || datum.LGA_NAME25 === facilityRegion",
                "value": 1
              },
              "value": 0.45
            }
          }
        },
        {
          "name": "council_label_1_ink",
          "data": {
            "url": "data/maps/graph_10_central_council_labels.csv"
          },
          "transform": [
            {
              "calculate": "split(replace(datum.LGA_NAME25, ' (Vic.)', ''), ' ')",
              "as": "label_lines"
            }
          ],
          "mark": {
            "type": "text",
            "font": "Arial",
            "fontWeight": "bold",
            "fontSize": 9,
            "lineHeight": 10,
            "color": "#29475a",
            "align": {
              "expr": "indexof(['Manningham', 'Monash'], datum.LGA_NAME25) >= 0 ? 'right' : indexof(['Maribyrnong', 'Hobsons Bay'], datum.LGA_NAME25) >= 0 ? 'left' : 'center'"
            },
            "baseline": "middle",
            "tooltip": false,
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "label_lines"
            },
            "opacity": {
              "condition": {
                "test": "facilityRegion === 'All regions' || datum.LGA_NAME25 === facilityRegion",
                "value": 1
              },
              "value": 0.45
            }
          }
        }
      ],
      "view": {
        "stroke": null,
        "fill": "#ffffff"
      }
    }
  ],
  "spacing": 48,
  "resolve": {
    "scale": {
      "size": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
