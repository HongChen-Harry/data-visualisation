{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "PLV 2024-25, 50 municipal/regional library services; excludes Vision Australia (no municipal population) and Victoria total. Local government operational funding, physical loans, branch visits and event attendance divided by source municipal population. Each axis separately min-max normalized across 50 services. Not an overall performance score.",
  "width": 820,
  "height": 400,
  "title": {
    "fontSize": 24,
    "subtitleFontSize": 13,
    "subtitlePadding": 7,
    "offset": 22,
    "anchor": "start",
    "color": "#172b40",
    "subtitleColor": "#526171",
    "text": "Library Service Profiles",
    "subtitle": "2024\u201325 \u00b7 Per-resident measures scaled independently from lowest (0) to highest (100)"
  },
  "data": {
    "url": "data/processed/graph_8_library_parallel_coordinates.csv",
    "format": {
      "type": "csv",
      "parse": {
        "normalized_value": "number",
        "value": "number",
        "metric_order": "number"
      }
    }
  },
  "params": [
    {
      "name": "selectedService",
      "value": "Yarra",
      "bind": {
        "input": "select",
        "options": [
          "Bayside",
          "Boroondara",
          "Brimbank",
          "Buloke",
          "Campaspe",
          "Central Highlands",
          "Connected Libraries",
          "Corangamite Moyne",
          "Darebin",
          "East Gippsland",
          "Frankston",
          "Gannawarra",
          "Geelong",
          "Glen Eira",
          "Glenelg",
          "Goldfields",
          "Goulburn Valley",
          "Greater Dandenong",
          "High Country",
          "Hindmarsh",
          "Hobsons Bay",
          "Hume",
          "Hyphen",
          "Indigo",
          "Kingston",
          "Latrobe",
          "Maribyrnong",
          "Melbourne",
          "Melton",
          "Merri-bek",
          "Mildura",
          "Mitchell",
          "Monash",
          "Moonee Valley",
          "Mornington Peninsula",
          "Murrindindi",
          "Myli",
          "Port Phillip",
          "Stonnington",
          "Swan Hill",
          "Towong",
          "Warrnambool",
          "Wellington",
          "Whitehorse Manningham",
          "Wimmera",
          "Wyndham",
          "Yarra",
          "Yarra Plenty",
          "Yarriambiack",
          "Your Library"
        ],
        "name": "Highlight library service: "
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "metric",
      "type": "ordinal",
      "sort": [
        "Local funding",
        "Physical loans",
        "Branch visits",
        "Event attendance"
      ],
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelPadding": 12,
        "labelExpr": "datum.label === 'Local funding' ? 'Local funding (AUD/person)' : datum.label === 'Physical loans' ? 'Physical loans / person' : datum.label === 'Branch visits' ? 'Branch visits / person' : 'Event attendance / person'"
      }
    },
    "y": {
      "field": "normalized_value",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          115
        ]
      },
      "axis": {
        "title": "Relative position within each measure",
        "values": [
          0,
          25,
          50,
          75,
          100
        ]
      }
    },
    "detail": {
      "field": "service"
    },
    "order": {
      "field": "metric_order"
    },
    "tooltip": [
      {
        "field": "service",
        "title": "Library service"
      },
      {
        "field": "metric",
        "title": "Measure"
      },
      {
        "field": "value",
        "type": "quantitative",
        "format": ".2f",
        "title": "Per-resident value"
      },
      {
        "field": "unit",
        "title": "Unit"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#b5cce0",
        "opacity": 0.25,
        "strokeWidth": 1
      }
    },
    {
      "transform": [
        {
          "filter": "datum.service === selectedService"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#08519c",
        "strokeWidth": 3,
        "point": {
          "filled": true,
          "size": 80
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.service === selectedService"
        },
        {
          "calculate": "(datum.metric === 'Local funding' ? '$' : '') + format(datum.value, '.2f')",
          "as": "value_label"
        },
        {
          "calculate": "datum.normalized_value + 4",
          "as": "label_y"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -5,
        "color": "#08519c",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "value_label"
        },
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              115
            ]
          },
          "axis": {
            "title": "Relative position within each measure",
            "values": [
              0,
              25,
              50,
              75,
              100
            ]
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "metric": "Physical loans",
            "normalized_value": 110
          }
        ]
      },
      "transform": [
        {
          "filter": "selectedService === 'Yarra'"
        }
      ],
      "mark": {
        "type": "text",
        "color": "#08519c",
        "fontWeight": "bold",
        "fontSize": 12,
        "align": "right",
        "dx": -8,
        "dy": -5
      },
      "encoding": {
        "text": {
          "value": "Yarra has the highest branch visits per resident (6.21)"
        },
        "tooltip": null
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#526b82",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "metric",
          "type": "ordinal",
          "sort": [
            "Local funding",
            "Physical loans",
            "Branch visits",
            "Event attendance"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelPadding": 12,
            "labelExpr": "datum.label === 'Local funding' ? 'Local funding (AUD/person)' : datum.label === 'Physical loans' ? 'Physical loans / person' : datum.label === 'Branch visits' ? 'Branch visits / person' : 'Event attendance / person'"
          }
        },
        "y": {
          "field": "normalized_value",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              115
            ]
          },
          "axis": {
            "title": "Relative position within each measure",
            "values": [
              0,
              25,
              50,
              75,
              100
            ]
          }
        },
        "y2": {
          "field": "label_y"
        }
      },
      "transform": [
        {
          "filter": "datum.service === selectedService"
        },
        {
          "calculate": "(datum.metric === 'Local funding' ? '$' : '') + format(datum.value, '.2f')",
          "as": "value_label"
        },
        {
          "calculate": "datum.normalized_value + 4",
          "as": "label_y"
        }
      ]
    },
    {
      "mark": {
        "type": "point",
        "shape": "triangle-up",
        "filled": true,
        "color": "#526b82",
        "size": 90,
        "strokeWidth": 0,
        "aria": false,
        "xOffset": {
          "expr": "-sin(datum.annotation_arrow_angle * PI / 180) * 9"
        },
        "yOffset": {
          "expr": "cos(datum.annotation_arrow_angle * PI / 180) * 9"
        }
      },
      "encoding": {
        "x": {
          "field": "metric",
          "type": "ordinal",
          "sort": [
            "Local funding",
            "Physical loans",
            "Branch visits",
            "Event attendance"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelPadding": 12,
            "labelExpr": "datum.label === 'Local funding' ? 'Local funding (AUD/person)' : datum.label === 'Physical loans' ? 'Physical loans / person' : datum.label === 'Branch visits' ? 'Branch visits / person' : 'Event attendance / person'"
          }
        },
        "y": {
          "field": "normalized_value",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              115
            ]
          },
          "axis": {
            "title": "Relative position within each measure",
            "values": [
              0,
              25,
              50,
              75,
              100
            ]
          }
        },
        "angle": {
          "field": "annotation_arrow_angle",
          "type": "quantitative",
          "scale": null
        },
        "tooltip": null
      },
      "transform": [
        {
          "filter": "datum.service === selectedService"
        },
        {
          "calculate": "(datum.metric === 'Local funding' ? '$' : '') + format(datum.value, '.2f')",
          "as": "value_label"
        },
        {
          "calculate": "datum.normalized_value + 4",
          "as": "label_y"
        },
        {
          "calculate": "atan2(0, (datum.normalized_value-datum.label_y) * 3.4782608695652173) * 180 / PI",
          "as": "annotation_arrow_angle"
        }
      ],
      "name": "annotation_arrow_8_root_5"
    },
    {
      "mark": {
        "type": "rule",
        "color": "#526b82",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "metric",
          "type": "ordinal",
          "sort": [
            "Local funding",
            "Physical loans",
            "Branch visits",
            "Event attendance"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelPadding": 12,
            "labelExpr": "datum.label === 'Local funding' ? 'Local funding (AUD/person)' : datum.label === 'Physical loans' ? 'Physical loans / person' : datum.label === 'Branch visits' ? 'Branch visits / person' : 'Event attendance / person'"
          }
        },
        "y": {
          "field": "normalized_value",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              115
            ]
          },
          "axis": {
            "title": "Relative position within each measure",
            "values": [
              0,
              25,
              50,
              75,
              100
            ]
          }
        },
        "x2": {
          "field": "target_metric"
        },
        "y2": {
          "field": "label_y"
        },
        "tooltip": null
      },
      "data": {
        "values": [
          {
            "metric": "Branch visits",
            "normalized_value": 100,
            "target_metric": "Physical loans",
            "label_y": 110
          }
        ]
      },
      "transform": [
        {
          "filter": "selectedService === 'Yarra'"
        }
      ]
    },
    {
      "mark": {
        "type": "point",
        "shape": "triangle-up",
        "filled": true,
        "color": "#526b82",
        "size": 90,
        "strokeWidth": 0,
        "aria": false,
        "xOffset": {
          "expr": "-sin(datum.annotation_arrow_angle * PI / 180) * 9"
        },
        "yOffset": {
          "expr": "cos(datum.annotation_arrow_angle * PI / 180) * 9"
        }
      },
      "encoding": {
        "x": {
          "field": "metric",
          "type": "ordinal",
          "sort": [
            "Local funding",
            "Physical loans",
            "Branch visits",
            "Event attendance"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelPadding": 12,
            "labelExpr": "datum.label === 'Local funding' ? 'Local funding (AUD/person)' : datum.label === 'Physical loans' ? 'Physical loans / person' : datum.label === 'Branch visits' ? 'Branch visits / person' : 'Event attendance / person'"
          }
        },
        "y": {
          "field": "normalized_value",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              115
            ]
          },
          "axis": {
            "title": "Relative position within each measure",
            "values": [
              0,
              25,
              50,
              75,
              100
            ]
          }
        },
        "tooltip": null,
        "angle": {
          "field": "annotation_arrow_angle",
          "type": "quantitative",
          "scale": null
        }
      },
      "data": {
        "values": [
          {
            "metric": "Branch visits",
            "normalized_value": 100,
            "target_metric": "Physical loans",
            "label_y": 110
          }
        ]
      },
      "transform": [
        {
          "filter": "selectedService === 'Yarra'"
        },
        {
          "calculate": "atan2((indexof([\"Local funding\", \"Physical loans\", \"Branch visits\", \"Event attendance\"],datum.metric)-indexof([\"Local funding\", \"Physical loans\", \"Branch visits\", \"Event attendance\"],datum.target_metric)) * 205.0, (datum.normalized_value-datum.label_y) * 3.4782608695652173) * 180 / PI",
          "as": "annotation_arrow_angle"
        }
      ],
      "name": "annotation_arrow_8_root_7"
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "gridColor": "#e6ecf1",
      "labelColor": "#43566a",
      "titleColor": "#43566a",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "title": {
      "fontSize": 24,
      "subtitleFontSize": 13,
      "subtitlePadding": 7,
      "offset": 22,
      "anchor": "start",
      "color": "#172b40",
      "subtitleColor": "#526171"
    }
  }
}
